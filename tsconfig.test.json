{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "tests/unit/**/*",
    "tests/component/**/*",
    "tests/setup.ts",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@/*": ["src/renderer/src/*"]
    }
  }
}
