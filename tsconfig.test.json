{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "tests/unit/**/*",
    "tests/component/**/*",
    "tests/setup.ts",
    "src/renderer/src/env.d.ts",
    "src/modules/translation/**/*",
    "src/modules/translation/**/*.vue",
    "src/preload/*.d.ts"
  ],
  "exclude": ["src/modules/**/tests/e2e/**"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@modules/*": ["src/modules/*"],
      "@main/*": ["src/main/*"],
      "@/*": ["src/renderer/src/*"]
    }
  }
}
