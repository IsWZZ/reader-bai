{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/modules/translation/main/**/*",
    "src/modules/translation/preload/**/*",
    "src/modules/translation/manifest.ts",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@modules/*": ["src/modules/*"]
    }
  }
}
